{
  "name": "factor-prover",
  "version": "1.0.0",
  "private": true,
  "description": "Autonomous factor-mining agent over Bitget cross-asset market data. Proposes, backtests, and adjudicates structured hypotheses under a preregistered statistical protocol.",
  "workspaces": [
    "apps/agent",
    "apps/web"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:agent": "npm run dev --workspace apps/agent",
    "dev:web": "npm run dev --workspace apps/web"
  }
}
