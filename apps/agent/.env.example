# ---------------------------------------------------------------------------
# Factor Prover — agent environment
# Copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- LLM (three-tier: Groq -> Gemini -> deterministic) ----------------------
# The LLM only PROPOSES hypotheses as strict JSON. It never sets thresholds
# and never decides a verdict — the deterministic gate does that.
#
# Primary: Groq. Free, no credit card. https://console.groq.com
# Model verified working 2026-09-11 against the live /v1/models list.
# NOTE: llama-3.3-70b-versatile was retired and no longer appears. Re-check
# the model list if this starts 404ing.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Fallback: Google Gemini. Free, no credit card. https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Which provider to try first: groq | gemini | anthropic | deterministic
LLM_PROVIDER=groq

# Last-resort deterministic enumerator so the loop never dies if both free
# tiers are rate-limited or down. Set false only if you want to hard-fail.
LLM_ALLOW_DETERMINISTIC_FALLBACK=true

# Optional: paid providers. Not required — the project runs free without them.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Bitget ----------------------------------------------------------------
# Public market data (candles, funding, tickers, symbols) needs NO key.
# These are only required for Agent Hub paper-order execution.
#
# THE THREE NAMES ARE THE CLI'S OWN, copied from `bgc --help`:
#   BITGET_API_KEY, BITGET_SECRET_KEY, BITGET_PASSPHRASE
#
# This file previously offered BITGET_API_SECRET and BITGET_API_PASSPHRASE —
# two variables no version of the CLI reads. Someone following it would have
# set both correctly-named and incorrectly-named variables and still been told
# their credentials were incomplete, with no way to see why. `describeCapability`
# had the same wrong pair and was corrected on 2026-09-18; this is the other
# half of that fix.
#
# All three are needed together. The SDK's error is
# "Provide apiKey, secretKey and passphrase together", so a partial set is not
# a partial capability — it is a ConfigError on every call.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# MUST stay "true". Execution Guard CHECK 1 refuses every order unless this
# env var is exactly the string "true". Do not flip this for the submission.
BITGET_PAPER_TRADING=true

# --- Loop bounds -----------------------------------------------------------
# Both optional. Unset MAX_LOOP_ITERATIONS_PER_RUN means "run until stopped",
# which is the point of an autonomous session; set it to bound a deployment on
# a free tier. Unset LOOP_ITERATION_DELAY_MS uses the loop's own default.
# A value that is not a positive integer is reported at boot and ignored rather
# than silently doing nothing.
MAX_LOOP_ITERATIONS_PER_RUN=
LOOP_ITERATION_DELAY_MS=

# --- Agent Hub (execution path) --------------------------------------------
# Only consulted when ENABLE_EXECUTION=true. Nothing here is needed to run the
# research loop or to serve the API.
#
# ENABLE_EXECUTION is OFF by default: orders are validated by the Execution
# Guard but never sent. Turn it on only to demo the paper-order path.
ENABLE_EXECUTION=false

# The Bitget Agent Hub CLI. Path to the binary, if it is not on PATH.
BGC_CLI_PATH=bgc
# Print the command instead of running it. Useful for showing what WOULD be sent.
BGC_DRY_RUN=false
BGC_TIMEOUT_MS=30000
# Extra arguments appended to the order command. Unset means none.
BGC_ORDER_ARGS=

# --- Server ----------------------------------------------------------------
PORT=8080

# Comma-separated list of browser origins allowed to call this API — in
# production, your Vercel URL. Read by src/index.ts, which builds an explicit
# allowlist from it; localhost:3000 is always allowed as well so the frontend
# can be developed against a deployed backend. An origin not listed here gets
# no CORS header, which is the point: two of the control routes change session
# state, so a reflected-origin policy would let any website stop a session.
#
# NOTE: this was previously documented as CORS_ORIGIN, which the server never
# read — following this file would have left the deployed frontend blocked.
WEB_ORIGIN=http://localhost:3000

# Optional. When SET, the three control routes (POST /api/start, /api/stop,
# /api/reset) require a matching `x-admin-token` header. When UNSET they are
# open to anyone who can reach the URL — fine for local work and a demo you are
# watching, wrong for an unattended public deployment. The server prints a loud
# warning at boot when this is empty. Set it on Render.
ADMIN_TOKEN=
