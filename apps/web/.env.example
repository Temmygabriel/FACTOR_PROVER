# Factor Prover — web (Vercel)
#
# This app holds NO secrets. It is a public read-only research record plus one
# operator control (the circuit-breaker reset, which records who asked). API
# keys, the LLM keys and the Bitget credentials belong to the agent service
# (apps/agent), never here — anything prefixed NEXT_PUBLIC_ is shipped to the
# browser and is readable by every visitor.

# Base URL of the agent API (apps/agent, deployed on Render).
# Local development:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Production (Render free tier — the service sleeps when idle, so the first
# request of a session can take ~50s; the UI shows an explicit "waking the
# backend" state rather than looking broken):
# NEXT_PUBLIC_API_BASE_URL=https://factor-prover-agent.onrender.com
